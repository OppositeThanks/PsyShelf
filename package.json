{
  "name": "psyshelf",
  "version": "0.3.0",
  "private": true,
  "description": "A private, local-first professional psychology resource library.",
  "author": "oppositethanks",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.cjs",
    "test:security": "electron scripts/security-smoke.cjs",
    "test:starter": "node scripts/starter-smoke.cjs",
    "audit:security": "pnpm audit --audit-level=low",
    "dist:win": "node scripts/license-notices.cjs && electron-builder --win nsis --publish never",
    "licenses": "node scripts/license-notices.cjs",
    "test:privacy": "electron scripts/privacy-smoke.cjs"
  },
  "devDependencies": {
    "electron": "43.7.6",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.personal.psyshelf",
    "productName": "PsyShelf",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "PsyShelf-Setup-${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "PsyShelf",
      "uninstallDisplayName": "PsyShelf"
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "7.0.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "tesseract.js"
    ]
  }
}
